# ============================================================
#  Tally Connector — Environment Variables Example
#  Copy to .env and fill in real values.
#  NEVER commit .env or connector-config.json to version control.
# ============================================================

# ----------------------------------------------------------
# ERP Server (your hosted back-end)
# Must be HTTPS in production; http://localhost is allowed for dev.
# ----------------------------------------------------------
ERP_BASE_URL=https://your-erp-server.example.com

# Bearer token issued by the ERP admin for this office connector.
# Treat like a password — stored ONLY on this office PC.
ERP_CONNECTOR_TOKEN=REPLACE_WITH_TOKEN_FROM_ERP_ADMIN

# ----------------------------------------------------------
# Local Tally Prime HTTP/XML endpoint
# Tally must be running and ODBC/HTTP server enabled (port 9000 by default).
# The connector only makes OUTBOUND calls to this address — it never
# opens a listening port itself.
# ----------------------------------------------------------
TALLY_HOST=localhost
TALLY_PORT=9000

# Company name as it appears exactly in Tally (leave blank to use first active company)
TALLY_COMPANY=

# ----------------------------------------------------------
# Connector behaviour
# ----------------------------------------------------------

# How often to poll the ERP for new jobs (milliseconds, default 30000 = 30 s)
POLL_INTERVAL_MS=30000

# Max jobs to fetch per poll cycle (default 10)
POLL_JOB_LIMIT=10

# How often to send a heartbeat to the ERP (milliseconds, default 60000 = 60 s)
HEARTBEAT_INTERVAL_MS=60000

# Exponential-backoff initial delay when Tally is offline (ms, default 5000)
BACKOFF_INITIAL_MS=5000

# Maximum backoff delay (ms, default 300000 = 5 min)
BACKOFF_MAX_MS=300000

# ----------------------------------------------------------
# Logging
# ----------------------------------------------------------
# LOG_LEVEL: error | warn | info | debug  (default: info)
LOG_LEVEL=info
